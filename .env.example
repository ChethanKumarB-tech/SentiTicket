# ==============================================================================
# SentiTicket — Environment Variable Configuration Template (.env.example)
# IMPORTANT: Copy this file to .env and fill in real values. Never commit .env!
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection
MONGODB_URI=mongodb://localhost:27017/sentiticket

# JWT & Refresh Token Secrets (Must be 32+ characters high entropy in production)
JWT_SECRET=development_jwt_secret_key_minimum_32_chars_long_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=development_refresh_token_secret_key_minimum_32_chars_long_67890
REFRESH_TOKEN_EXPIRES_IN=7d

# Password Reset & Email Verification Token Expiry
PASSWORD_RESET_TOKEN_EXPIRES_IN=15m
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# MFA TOTP Encryption Key (32 chars hex / high-entropy string)
MFA_ENCRYPTION_KEY=development_mfa_aes_encryption_key_32_bytes!!

# Python ML Microservice Configuration
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_SECRET=development_internal_ml_service_shared_secret_12345

# SMTP / Email Configuration (Optional for mock development)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SentiTicket Support <support@sentiticket.local>"

# File Upload Storage
UPLOAD_STORAGE_PATH=./uploads
MAX_FILE_SIZE_BYTES=10485760
